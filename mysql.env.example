# Copy this file to mysql.env and set both passwords before running `docker compose up`.
# mysql.env is gitignored; never commit real passwords.
#
# Everything after the "=" is the password, exactly as written: $, #, &, %, ", spaces and
# letters like ä or € are all fine, and nothing needs quoting or escaping. Don't put quotes
# around it, they would become part of the password.
# Two characters can't be used: the single quote (') and the backslash (\). The MySQL image
# doesn't cope with them when it creates the accounts.
#
# MySQL takes these passwords on its first start only. To change them later, change them in
# MySQL itself (and here), or remove the mysql-data volume to start with an empty database.

# MySQL's administrator. Tapeory doesn't use it; the backup commands in the README do.
MYSQL_ROOT_PASSWORD=change-me-root
# The password to enter in Tapeory's first-start setup.
MYSQL_PASSWORD=change-me-tapeory
