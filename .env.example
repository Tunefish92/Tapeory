# Copy this file to .env and fill in real values before running `docker compose up`.
# .env is gitignored; never commit real passwords.

# --- MySQL ---
# On first start, Tapeory's web UI asks for the database connection: server "mysql", port 3306,
# and the database/user/password below.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=tapeory
MYSQL_USER=tapeory
MYSQL_PASSWORD=change-me-tapeory

# --- Tapeory API / web (served together from one container) ---
# ASPNETCORE_ENVIRONMENT=Production
# Host port the app is reachable on (container always listens on 8080 internally).
TAPEORY_PORT=8080
# Host folder that becomes the app's /data volume (templates, uploads, print output).
# Back this up regularly — see README.md for backup/restore instructions.
TAPEORY_STORAGE_HOST_PATH=./tapeory-data
# User and group ID that owns the storage folder; the app runs as this user. Run `id` on the
# host to find yours (Unraid: PUID=99, PGID=100).
PUID=1000
PGID=1000
# Apply database migrations automatically on startup.
# TAPEORY_AUTO_MIGRATE=true
# Image to run. Defaults to the published image; change it to pin a version, e.g. :0.4.0.
# The same image is on Docker Hub: TAPEORY_IMAGE=tunefish92/tapeory:latest
# TAPEORY_IMAGE=ghcr.io/tunefish92/tapeory:latest
